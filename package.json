{
  "name": "agents-kit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "version:patch": "npm version patch -ws --no-git-tag-version && node scripts/sync-versions.mjs",
    "version:minor": "npm version minor -ws --no-git-tag-version && node scripts/sync-versions.mjs",
    "version:major": "npm version major -ws --no-git-tag-version && node scripts/sync-versions.mjs",
    "publish": "npm publish -w packages/ai --access public"
  },
  "devDependencies": {
    "turbo": "^2.9.9",
    "typescript": "^5.8.0",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@10.29.3"
}
