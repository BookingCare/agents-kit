{
  "name": "agents-kit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" && turbo run lint type-check",
    "release:patch": "pnpm -r exec -- npm version patch --no-git-tag-version && node scripts/sync-versions.mjs",
    "release:minor": "pnpm -r exec -- npm version minor --no-git-tag-version && node scripts/sync-versions.mjs",
    "release:major": "pnpm -r exec -- npm version major --no-git-tag-version && node scripts/sync-versions.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "publish": "pnpm run publish:packages",
    "publish:packages": "node scripts/publish-packages.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "turbo": "^2.9.9",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.29.3"
}
