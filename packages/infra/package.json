{
  "name": "@bookingcare/infra",
  "version": "0.5.2",
  "description": "Sandbox execution and persistence for process-isolated agent tools with resource limits",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "default": "./dist/persistence/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@bookingcare/tsconfig": "^0.5.2",
    "@types/node": "^25.6.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@bookingcare/ai": "^0.5.2",
    "mysql2": "^3.22.3"
  }
}
